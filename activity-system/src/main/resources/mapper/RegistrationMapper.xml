<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  RegistrationMapper.xml  V2.0
  - pageMyRegistrations : 学生报名记录 (联表 activity, 含 wait_order)
  - pageWaitingQueue    : 教师端候补队列 (按 wait_order ASC)
  - listForExport       : 教师端报名名单导出 (学号/姓名/年级/报名时间/状态)
  年级 grade 由 user_no 提取: SUBSTRING(user_no, 2, 4) -> "2024" 等
-->
<mapper namespace="com.campus.activity.mapper.RegistrationMapper">

    <!-- 学生报名记录 VO 结果映射 -->
    <resultMap id="RegistrationVOMap" type="com.campus.activity.dto.RegistrationVO">
        <id     property="recordId"      column="record_id"/>
        <result property="activityId"    column="activity_id"/>
        <result property="title"          column="title"/>
        <result property="activityTime"   column="activity_time"/>
        <result property="location"       column="location"/>
        <result property="description"    column="description"/>
        <result property="signupTime"     column="signup_time"/>
        <result property="status"         column="status"/>
        <result property="waitOrder"      column="wait_order"/>
    </resultMap>

    <!-- 分页查询学生报名记录, 联表 activity (含已删活动, 便于历史追溯) -->
    <select id="pageMyRegistrations" resultMap="RegistrationVOMap">
        SELECT
            r.record_id,
            r.activity_id,
            r.status,
            r.wait_order,
            r.signup_time,
            a.title,
            a.activity_time,
            a.location,
            a.description
          FROM registration r
          LEFT JOIN activity a ON a.activity_id = r.activity_id
         WHERE r.student_account = #{account}
           <if test="status != null and status != ''">
               AND r.status = #{status}
           </if>
         ORDER BY r.signup_time DESC
    </select>

    <!-- 候补队列项 VO 结果映射 -->
    <resultMap id="WaitingQueueVOMap" type="com.campus.activity.dto.WaitingQueueVO">
        <id     property="recordId"       column="record_id"/>
        <result property="studentAccount" column="student_account"/>
        <result property="studentNo"      column="user_no"/>
        <result property="studentName"    column="name"/>
        <result property="grade"          column="grade"/>
        <result property="signupTime"     column="signup_time"/>
        <result property="waitOrder"      column="wait_order"/>
    </resultMap>

    <!-- 教师端: 候补队列分页 (按 wait_order ASC) -->
    <select id="pageWaitingQueue" resultMap="WaitingQueueVOMap">
        SELECT
            r.record_id,
            r.student_account,
            u.user_no,
            u.name,
            SUBSTRING(u.user_no, 2, 4) AS grade,
            r.signup_time,
            r.wait_order
          FROM registration r
          LEFT JOIN sys_user u ON u.account = r.student_account
         WHERE r.activity_id = #{activityId}
           AND r.status = 'WAITING'
         ORDER BY r.wait_order ASC
    </select>

    <!-- 报名名单导出 VO 结果映射 -->
    <resultMap id="RegistrationExportVOMap" type="com.campus.activity.dto.RegistrationExportVO">
        <id     property="recordId"       column="record_id"/>
        <result property="studentAccount" column="student_account"/>
        <result property="studentNo"      column="user_no"/>
        <result property="studentName"    column="name"/>
        <result property="grade"          column="grade"/>
        <result property="signupTime"     column="signup_time"/>
        <result property="status"         column="status"/>
        <result property="waitOrder"      column="wait_order"/>
    </resultMap>

    <!-- 教师端: 报名名单导出 (含学号/姓名/年级/报名时间/状态), 全量返回 -->
    <select id="listForExport" resultMap="RegistrationExportVOMap">
        SELECT
            r.record_id,
            r.student_account,
            u.user_no,
            u.name,
            SUBSTRING(u.user_no, 2, 4) AS grade,
            r.signup_time,
            r.status,
            r.wait_order
          FROM registration r
          LEFT JOIN sys_user u ON u.account = r.student_account
         WHERE r.activity_id = #{activityId}
           AND r.status IN ('ENROLLED','WAITING')
         ORDER BY r.status, r.wait_order ASC, r.signup_time ASC
    </select>

</mapper>
